#!/bin/bash

# Give Clippy a real voice, locally — no cloud calls, the model runs on your
# machine. It sets `tts` and writes the glue around an engine (the kokoro
# say.py, the clone daemon and client); it installs NOTHING and downloads
# NOTHING. When an engine or a model isn't here it prints the exact
# commands and stops, so every fetch runs under your eyes with your own
# pins. docs/voice.md has the same steps with the prose around them.
# Modes:
#   scripts/setup-voice                    # bare: the shipped Rubick clone if
#                                          # chatterbox and an NVIDIA GPU are
#                                          # here, robot George if kokoro is
#   scripts/setup-voice --robot            # robot George (kokoro), GPU or not
#   scripts/setup-voice af_heart           # any kokoro voice you've fetched
#   scripts/setup-voice en_US-ryan-high    # any piper voice you've fetched
#   scripts/setup-voice --clone ~/sample.mp4 [name]   # clone ANY voice from a
#                                          # 10-20 s sample — yours included.
#                                          # Needs chatterbox and an NVIDIA GPU.
#   scripts/setup-voice --clone ~/scene.mp4 name --from 5:59 --to 6:12
#                                          # the same, cut out of a longer
#                                          # recording (ffmpeg times; --from
#                                          # alone runs to the 20 s cap).
#                                          # The sample is loudness-normalised,
#                                          # so a quiet rip needs no prep.
#                                          # Once set, the plugin pre-renders
#                                          # the whole book in the background.
# kokoro (~340 MB) sounds better; piper (~60-120 MB) is lighter. Pick a name
# out of their catalogs, fetch it, then name it here:
#   https://huggingface.co/hexgrad/Kokoro-82M/blob/main/VOICES.md
#   https://rhasspy.github.io/piper-samples/
# All modes talk to `tts` the same way: the line on stdin, raw samples to
# aplay (not pw-play — sndfile can't read raw audio from a pipe).

set -euo pipefail

HERE="$(cd "$(dirname "$(realpath "$0")")/.." && pwd)"

# "Powerful enough" for the shipped clone: a working NVIDIA GPU with room for
# chatterbox's ~4 GB resident model.
gpu_ok() {
  command -v nvidia-smi >/dev/null || return 1
  local mib
  mib="$(nvidia-smi --query-gpu=memory.total --format=csv,noheader,nounits 2>/dev/null | sort -nr | head -1)"
  [ -n "$mib" ] && [ "$mib" -ge 6000 ] 2>/dev/null
}

# Where each engine has to live for the commands this script writes to find
# it. They are the paths in docs/voice.md, and the ones printed below when
# something is missing: a voice installed somewhere else is a drop-in file
# (docs/voice.md), not this script's business.
KOKORO_DIR="$HOME/.local/share/kokoro-tts"
PIPER_DIR="$HOME/.local/share/piper-tts"
PIPER_VOICES="$HOME/.local/share/piper-voices"
CLONE_DIR="$HOME/.local/share/chatterbox-tts"
DOCS="the long version is docs/voice.md in the plugin dir"

# Is it here? Only what the USER has to put there — say.py, the daemon and
# speak-clone are written by this script, so they are never part of it.
kokoro_ready() {
  [ -x "$KOKORO_DIR/venv/bin/python" ] \
    && [ -s "$KOKORO_DIR/kokoro-v1.0.onnx" ] && [ -s "$KOKORO_DIR/voices-v1.0.bin" ]
}
piper_engine_ready() { [ -x "$PIPER_DIR/venv/bin/piper" ]; }
piper_voice_ready() { [ -s "$PIPER_VOICES/$1.onnx" ] && [ -s "$PIPER_VOICES/$1.onnx.json" ]; }
# The daemon's exact imports, not just the venv's python: an install
# interrupted mid-torch leaves venv/bin/python behind, and the daemon then
# dies on `import torchaudio` before it binds its socket ("daemon never came
# up"). ~5 s on a healthy venv.
clone_engine_ready() { "$CLONE_DIR/venv/bin/python" -c 'import torchaudio, chatterbox.tts' &>/dev/null; }
# The model, separately, because it is a separate step: the daemon runs with
# HF_HUB_OFFLINE, so what is not in the cache now is a stop here rather than
# a silent 3 GB download on his first line.
clone_model_ready() {
  HF_HUB_OFFLINE=1 "$CLONE_DIR/venv/bin/python" -c 'from huggingface_hub import hf_hub_download as d
[d(repo_id="ResembleAI/chatterbox", filename=f) for f in ("ve.safetensors", "t3_cfg.safetensors", "s3gen.safetensors", "tokenizer.json", "conds.pt")]' &>/dev/null
}

# What to run when it is not. These are printed, never executed — the point
# of the split: nothing this repo ships resolves a package version or a
# model URL for you, so there is no unpinned install and no unverified
# download inside the plugin. Your shell, your pins, your checksums.
how_kokoro() {
  cat >&2 <<EOF

kokoro isn't here, and this script doesn't install things. Four commands,
~340 MB, no GPU needed:

  python3 -m venv $KOKORO_DIR/venv
  $KOKORO_DIR/venv/bin/pip install kokoro-onnx
  curl -fL --create-dirs -o $KOKORO_DIR/kokoro-v1.0.onnx \\
    https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.0/kokoro-v1.0.onnx
  curl -fL -o $KOKORO_DIR/voices-v1.0.bin \\
    https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.0/voices-v1.0.bin

Pin the version, check the hashes, read the release page first — they are
your commands. Then run this again ($DOCS).
EOF
}

how_piper() {  # $1 voice, $2 lang, $3 locale, $4 speaker, $5 quality
  local u="https://huggingface.co/rhasspy/piper-voices/resolve/main/$2/$3/$4/$5"
  echo >&2
  if ! piper_engine_ready; then
    cat >&2 <<EOF
piper isn't here, and this script doesn't install things. The engine, once:

  python3 -m venv $PIPER_DIR/venv
  $PIPER_DIR/venv/bin/pip install piper-tts
EOF
    echo >&2
  fi
  cat >&2 <<EOF
The $1 voice itself, ~60-120 MB (browse them at
https://rhasspy.github.io/piper-samples/):

  curl -fL --create-dirs -o $PIPER_VOICES/$1.onnx \\
    $u/$1.onnx
  curl -fL -o $PIPER_VOICES/$1.onnx.json \\
    $u/$1.onnx.json

resolve/main is a moving ref — swap it for a commit sha off the repo if you
want the same bytes twice. Then run this again ($DOCS).
EOF
}

how_clone_engine() {
  cat >&2 <<EOF

chatterbox isn't here (or its venv is half-built), and this script doesn't
install things. It wants its own Python 3.12 and ~6 GB of torch, so uv:

  sudo pacman -S uv
  uv venv $CLONE_DIR/venv --python 3.12
  uv pip install --python $CLONE_DIR/venv/bin/python chatterbox-tts "setuptools<81"

That setuptools pin isn't optional — chatterbox's watermarker still imports
pkg_resources, and without it the model load dies on "'NoneType' object is
not callable". Pin chatterbox-tts itself too if you want the same venv
twice. Then the model, below.
EOF
  how_clone_model
}

how_clone_model() {
  cat >&2 <<EOF

The chatterbox model is five files, ~3 GB, fetched once. The daemon never
downloads — it loads what is already in your Hugging Face cache — so this
is the one command that puts it there:

  $CLONE_DIR/venv/bin/python -c 'from huggingface_hub import hf_hub_download as d
[d(repo_id="ResembleAI/chatterbox", filename=f) for f in ("ve.safetensors", "t3_cfg.safetensors", "s3gen.safetensors", "tokenizer.json", "conds.pt")]'

Pass revision="<a commit sha off huggingface.co/ResembleAI/chatterbox>" to
d() to pin the exact bytes. Then run this again ($DOCS).
EOF
}

# Bare mode with nothing to point him at: every route, cheapest first.
how_nothing() {
  cat >&2 <<EOF

Nothing this script can point him at is on this machine, and it doesn't
install things — it wires up an engine you already have.

The cheapest voice needs neither this script nor a model: the espeak-ng
robot, which is what he was built around.

  sudo pacman -S espeak-ng
  omarchy-shell costafot.clippy set tts true
EOF
  how_kokoro
  if gpu_ok; then
    how_clone_engine
  else
    echo >&2
    echo "Voice cloning is the third route and wants an NVIDIA GPU with 6 GB, which" >&2
    echo "this machine doesn't have. You're poor. Get more RAM." >&2
  fi
}

usage() { sed -n '3,/^$/p' "$0" | sed 's/^# \{0,1\}//'; }
case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  --clone|--robot|"") ;;
  --*) echo "setup-voice: unknown option $1" >&2; echo >&2; usage >&2; exit 2 ;;
esac

MODE=voice
BLESSED=""
SHIPPED=""
FROM="" TO=""
if [ "${1:-}" = "--clone" ]; then
  MODE=clone
  shift
  SAMPLE="" NAME=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --from) FROM="${2:?--from needs a time (ffmpeg form: 95, 1:35, 0:01:35.5)}"; shift 2 ;;
      --to)   TO="${2:?--to needs a time (ffmpeg form: 118, 1:58, 0:01:58.5)}"; shift 2 ;;
      --*) echo "setup-voice --clone: unknown option $1" >&2; exit 2 ;;
      *) if [ -z "$SAMPLE" ]; then SAMPLE="$1"; elif [ -z "$NAME" ]; then NAME="$1"
         else echo "setup-voice --clone: one sample, one name — what is '$1'?" >&2; exit 2; fi; shift ;;
    esac
  done
  [ -n "$SAMPLE" ] || { echo "usage: setup-voice --clone <sample.wav|mp3|mp4> [name] [--from T] [--to T]" >&2; exit 2; }
  [ -f "$SAMPLE" ] || { echo "setup-voice --clone: no such file: $SAMPLE" >&2; exit 2; }
  [ -n "$NAME" ] || NAME="$(basename "${SAMPLE%.*}" | tr -cd 'A-Za-z0-9_-')"
  [ -n "$NAME" ] || { echo "setup-voice --clone: give the voice a name ([A-Za-z0-9_-])" >&2; exit 2; }
elif [ "${1:-}" = "--robot" ]; then
  BLESSED=1
elif [ $# -eq 0 ]; then
  # Bare mode picks the best voice ALREADY INSTALLED, not the best this
  # machine could run: the script has nothing to install with. The venv
  # check here is the cheap one — setup_clone runs the real probe and
  # prints the fix if it is half-built.
  if gpu_ok && [ -x "$CLONE_DIR/venv/bin/python" ]; then
    MODE=clone SHIPPED=1
    SAMPLE="$HERE/assets/voices/rubick.wav"
    NAME=rubick
    echo "NVIDIA GPU and chatterbox found — you get the shipped voice, a Rubick clone (--robot picks the kokoro robot instead)"
  elif kokoro_ready; then
    BLESSED=1
    if gpu_ok; then
      echo "the GPU is there but chatterbox isn't, so no clone today — kokoro is, so the robot it is"
    else
      echo "no NVIDIA GPU with 6 GB to spare — you're poor. Get more RAM. Until then, the robot it is"
    fi
  else
    how_nothing
    exit 1
  fi
fi

# The blessed non-clone voice: kokoro's bm_george put through a robot — pitch
# up 15%, ring-mod tremolo, bit-crush, band-limit. Dialed in by ear, one knob
# at a time. A named voice comes through unprocessed.
VOICE="${1:-bm_george}"
[ -n "$BLESSED" ] && VOICE=bm_george
ROBOT_FX="asetrate=24000*1.15,aresample=24000,atempo=0.870,tremolo=f=45:d=0.8,acrusher=bits=6:mode=log:aa=1,highpass=f=250,lowpass=f=3400"
HELLO="Oh my! It looks like you're giving me a voice. You will regret this."

setup_kokoro() {
  local base="$KOKORO_DIR" venv="$KOKORO_DIR/venv"
  kokoro_ready || { how_kokoro; exit 1; }
  cat > "$base/say.py" <<PY
#!$venv/bin/python
# Line on stdin -> raw s16 mono 24 kHz on stdout. KOKORO_VOICE/KOKORO_SPEED to taste.
import sys, os
text = sys.stdin.read().strip()
if not text:
    sys.exit(0)
import numpy as np
from kokoro_onnx import Kokoro
d = os.path.dirname(os.path.realpath(__file__))
k = Kokoro(f"{d}/kokoro-v1.0.onnx", f"{d}/voices-v1.0.bin")
voice = os.environ.get("KOKORO_VOICE", "am_adam")
lang = "en-gb" if voice.startswith("b") else "en-us"
samples, sr = k.create(text, voice=voice,
                       speed=float(os.environ.get("KOKORO_SPEED", "1.0")), lang=lang)
sys.stdout.buffer.write((np.clip(samples, -1, 1) * 32767).astype(np.int16).tobytes())
PY
  chmod +x "$base/say.py"
  CMD="KOKORO_VOICE=$VOICE $base/say.py"
  [ -n "$BLESSED" ] && CMD="$CMD | ffmpeg -hide_banner -loglevel quiet -f s16le -ar 24000 -ac 1 -i - -af '$ROBOT_FX' -f s16le -"
  CMD="$CMD | aplay -q -t raw -r 24000 -f S16_LE -c 1 -"
  # Background + wait, so bash's TERM trap runs promptly and kills aplay —
  # a foreground pipeline defers the trap until the job ends, and a replaced
  # line would keep playing over the next one (the clone had the same bug).
  CMD="trap 'kill \$! 2>/dev/null' TERM; $CMD & wait \$!"
}

setup_piper() {
  local venv="$PIPER_DIR/venv" voices="$PIPER_VOICES"
  local locale speaker quality lang
  IFS=- read -r locale speaker quality <<< "$VOICE"
  lang="${locale%%_*}"
  # Without a download to 404, a malformed name would otherwise be printed
  # back as an install command with a nonsense URL in it.
  [ -n "$quality" ] || {
    echo "setup-voice: $VOICE isn't a piper name — those are locale-speaker-quality, like en_US-ryan-high" >&2
    exit 2
  }
  if ! piper_engine_ready || ! piper_voice_ready "$VOICE"; then
    how_piper "$VOICE" "$lang" "$locale" "$speaker" "$quality"
    exit 1
  fi
  local rate; rate="$(jq -r .audio.sample_rate "$voices/$VOICE.onnx.json")"
  CMD="$venv/bin/piper -m $voices/$VOICE.onnx --output-raw 2>/dev/null | aplay -q -t raw -r $rate -f S16_LE -c 1 -"
  # Background + wait, so bash's TERM trap runs promptly and kills aplay —
  # a foreground pipeline defers the trap until the job ends, and a replaced
  # line would keep playing over the next one (the clone had the same bug).
  CMD="trap 'kill \$! 2>/dev/null' TERM; $CMD & wait \$!"
}

setup_clone() {
  local base="$CLONE_DIR" venv="$CLONE_DIR/venv"
  command -v nvidia-smi >/dev/null || {
    echo "cloning synthesizes every line with chatterbox, which needs an NVIDIA GPU" >&2
    exit 1
  }
  clone_engine_ready || { how_clone_engine; exit 1; }
  clone_model_ready || { how_clone_model; exit 1; }
  mkdir -p "$base/voices"
  if [ -n "$SHIPPED" ]; then
    # the shipped sample is already the exact approved 20 s mono take —
    # copy it verbatim, a re-encode sounds subtly different
    cp "$SAMPLE" "$base/voices/$NAME.wav"
  else
    # 20 s of clean mono speech is what the cloner wants; ffmpeg reads
    # anything. --from/--to cut it out of a longer recording (input-side
    # seek, so --to is a position in the source, not a duration), the 20 s
    # cap still applies after the cut. loudnorm lifts a quiet rip to speech
    # level — the clone copies the sample's level as "character", and a
    # -30 LUFS YouTube rip came out muffled (Grossman, 2026-08-29).
    local cut=()
    [ -n "$FROM" ] && cut+=(-ss "$FROM")
    [ -n "$TO" ] && cut+=(-to "$TO")
    if [ -f "$base/voices/$NAME.wav" ]; then
      echo "re-cloning $NAME: the old sample is replaced; lines rendered from it are"
      echo "  not reused (the line cache is keyed by the sample's contents) — the plugin"
      echo "  re-renders the book in the background once he's set, like a fresh clone"
    fi
    ffmpeg -y -v error "${cut[@]}" -i "$SAMPLE" -vn -ac 1 -ar 24000 -t 20 \
      -af loudnorm=I=-18:TP=-1.5:LRA=11 "$base/voices/$NAME.wav" || {
      echo "setup-voice --clone: ffmpeg couldn't read $SAMPLE${FROM:+ from $FROM}${TO:+ to $TO}" >&2
      rm -f "$base/voices/$NAME.wav"; exit 1
    }
    local secs
    secs="$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$base/voices/$NAME.wav" 2>/dev/null | cut -d. -f1)"
    echo "sample: ${secs:-?} s of $(basename "$SAMPLE")${FROM:+ from $FROM}${TO:+ to $TO}, normalised to -18 LUFS"
    if [ "${secs:-0}" -lt 8 ] 2>/dev/null; then
      echo "  that's short — the clone wants 10-20 s of clean speech; expect a rougher voice"
    elif [ -z "$TO" ] && [ "${secs:-0}" -ge 20 ] 2>/dev/null; then
      echo "  capped at the first 20 s${FROM:+ after $FROM}; --to picks the end if that's the wrong stretch"
    fi
  fi

  cat > "$base/daemon.py" <<'PY'
#!VENV_PYTHON
# Keeps the chatterbox model on the GPU; speak-clone talks to it over a unix
# socket. Exits after 15 idle minutes so the VRAM comes back. As the raw
# renders' only writer it also keeps the cache bounded: after every render
# (and once on start) the oldest-played lines go until the dir is under
# CACHE_MB — the plugin's voiceCacheMb key, handed over as the
# CLIPPY_VOICE_CACHE_MB env var by whichever of its processes spawned us;
# 0 means no cap. speak-clone/warm-voice touch a file's mtime on every hit,
# so "oldest" is least-recently-played, not first-rendered — a warmed book
# stays put while agent one-offs and lines from a superseded sample age out.
import json, os, socket, sys
os.environ.setdefault("TQDM_DISABLE", "1")  # no progress bars in daemon.log
# Nothing here fetches: the model is fetched once, by hand, by whoever
# installed chatterbox (setup-voice prints the command, docs/voice.md
# explains it), and this only ever loads it out of the local HF cache.
# setdefault, not a hard-code — HF_HUB_OFFLINE=0 in the environment is
# still your call — and it has to be set before huggingface_hub is
# imported, which chatterbox does at import time.
os.environ.setdefault("HF_HUB_OFFLINE", "1")
try:
    CACHE_MB = int(os.environ.get("CLIPPY_VOICE_CACHE_MB", "500"))
except ValueError:
    CACHE_MB = 500  # a garbage env var must not kill the voice

def prune(cache, keep=None):
    if CACHE_MB <= 0:  # 0 = no cap, the pre-cap behaviour
        return
    files, total = [], 0
    for n in os.listdir(cache):
        if not n.endswith(".wav"):
            continue
        try:
            st = os.stat(os.path.join(cache, n))
        except OSError:
            continue
        total += st.st_size
        if n != keep:  # the line just rendered counts but never goes
            files.append((st.st_mtime, st.st_size, n))
    for _, sz, n in sorted(files):
        if total <= CACHE_MB * 1024 * 1024:
            break
        try:
            os.unlink(os.path.join(cache, n))
            total -= sz
        except OSError:
            pass
RUN = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
SOCK = os.path.join(RUN, "clippy-voice.sock")
s = socket.socket(socket.AF_UNIX)
try:
    s.bind(SOCK)
except OSError:
    probe = socket.socket(socket.AF_UNIX)
    try:
        probe.connect(SOCK)
        probe.close()
        sys.exit(0)  # another daemon is alive
    except OSError:
        os.unlink(SOCK)
        s.bind(SOCK)
s.listen(4)
s.settimeout(900)
import torchaudio
from chatterbox.tts import ChatterboxTTS
try:
    model = ChatterboxTTS.from_pretrained(device="cuda")
except OSError as e:
    # LocalEntryNotFoundError under HF_HUB_OFFLINE, i.e. the model was never
    # fetched. One line, because speak-clone reports the log's last line.
    sys.exit("chatterbox's model isn't in the local cache and this daemon never downloads it"
             " — run scripts/setup-voice and it prints the one command that fetches it"
             " (five files, ~3 GB); the loader said: " + str(e).replace("\n", " ")[:200])
prune(os.path.expanduser("~/.cache/clippy-voice"))
while True:
    try:
        c, _ = s.accept()
    except socket.timeout:
        break
    try:
        req = json.loads(c.makefile().readline())
        wav = model.generate(req["text"], audio_prompt_path=req["ref"],
                             exaggeration=req.get("exag", 0.5), cfg_weight=req.get("cfg", 0.5))
        tmp = req["out"] + ".tmp.wav"
        torchaudio.save(tmp, wav.cpu(), model.sr)
        os.replace(tmp, req["out"])
        prune(os.path.dirname(req["out"]), keep=os.path.basename(req["out"]))
        c.sendall(b"ok\n")
    except Exception as e:
        try:
            c.sendall(("err " + str(e)).encode() + b"\n")
        except OSError:
            pass
    finally:
        c.close()
os.unlink(SOCK)
PY
  sed -i "1s|.*|#!$venv/bin/python|" "$base/daemon.py"
  chmod +x "$base/daemon.py"

  cat > "$base/speak-clone" <<'PY'
#!/usr/bin/env python3
# Clippy voice-clone client: the line on stdin, played in the cloned voice.
# Cached by (ref path, ref contents, knobs, text); cache hits never touch the
# daemon. The contents hash is what makes a re-clone under the same name
# safe: without it, lines rendered from the old sample kept playing.
# --pitch shifts after synthesis (ffmpeg, tempo kept): <1 deeper, >1 higher.
# --tempo speeds up (>1) or slows (<1) playback, pitch kept. Both are
# derived from the cached raw take, so neither ever touches the GPU.
# CLIPPY_VOICE_VOLUME (0-1, the plugin's voiceVolume key) rides in the
# environment — not a flag, so a client older than the knob just ignores it
# — and is applied in the same ffmpeg step, as its own derivative.
# Every hit touches the file's mtime: the daemon prunes least-recently-played
# first, so a line that keeps getting said keeps its render.
import argparse, hashlib, json, os, socket, subprocess, sys, time
p = argparse.ArgumentParser()
p.add_argument("--ref", required=True)
p.add_argument("--exag", type=float, default=0.5)
p.add_argument("--cfg", type=float, default=0.5)
p.add_argument("--pitch", type=float, default=1.0)
p.add_argument("--tempo", type=float, default=1.0)
a = p.parse_args()
try:
    vol = min(1.0, max(0.0, float(os.environ.get("CLIPPY_VOICE_VOLUME", "1") or 1)))
except ValueError:
    vol = 1.0  # garbage in the env must never cost a line
text = sys.stdin.read().strip()
if not text:
    sys.exit(0)
ref = os.path.realpath(os.path.expanduser(a.ref))
with open(ref, "rb") as f:
    refhash = hashlib.sha256(f.read()).hexdigest()[:12]
key = hashlib.sha256(f"{ref}|{refhash}|{a.exag}|{a.cfg}|{text}".encode()).hexdigest()[:24]
cache = os.path.expanduser("~/.cache/clippy-voice")
os.makedirs(cache, exist_ok=True)
raw = f"{cache}/{key}.wav"
if os.path.exists(raw):
    try:
        os.utime(raw)
    except OSError:
        pass  # pruned in the exists/utime gap; the next call re-renders it
else:
    sockp = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "clippy-voice.sock")
    here = os.path.dirname(os.path.realpath(__file__))
    BUSY = ("speak-clone: the daemon is still working after 2 minutes — a cold"
            " start loads ~3 GB onto the GPU, and a busy machine takes longer"
            " than that. It keeps going in the background; try again in a few"
            " minutes (log: ~/.cache/clippy-voice/daemon.log)")
    def logtail():
        try:
            return open(f"{cache}/daemon.log", errors="replace").read().strip().splitlines()[-1]
        except (OSError, IndexError):
            return ""
    def ask():
        c = socket.socket(socket.AF_UNIX)
        c.settimeout(120)
        c.connect(sockp)
        c.sendall((json.dumps({"text": text, "ref": ref, "exag": a.exag,
                               "cfg": a.cfg, "out": raw}) + "\n").encode())
        r = c.makefile().readline().strip()
        c.close()
        if not r:
            # EOF: the daemon died with our request in hand — same as a reset,
            # so raise the same thing and let the caller respawn or report
            raise ConnectionResetError
        if r != "ok":
            sys.exit(f"speak-clone: {r}")
    try:
        ask()
    except (FileNotFoundError, ConnectionRefusedError, ConnectionResetError):
        log = open(f"{cache}/daemon.log", "wb")  # one daemon's worth, not forever
        subprocess.Popen([f"{here}/daemon.py"], start_new_session=True, stdout=log, stderr=log)
        for _ in range(240):  # first start loads the model, ~20 s
            time.sleep(0.5)
            try:
                ask()
                break
            # a reset here is the daemon dying mid-load under us; the retries
            # then collapse into refused-connects and the report below
            except (FileNotFoundError, ConnectionRefusedError, ConnectionResetError):
                continue
            except TimeoutError:
                sys.exit(BUSY)
        else:
            why = logtail()
            sys.exit("speak-clone: daemon never came up"
                     + (f" — {why}" if why else "")
                     + " (full log: ~/.cache/clippy-voice/daemon.log)")
    except TimeoutError:
        sys.exit(BUSY)
out = raw
if a.pitch != 1.0 or a.tempo != 1.0 or vol != 1.0:
    out = f"{cache}/{key}" + (f"-p{a.pitch:g}" if a.pitch != 1.0 else "") \
        + (f"-t{a.tempo:g}" if a.tempo != 1.0 else "") \
        + (f"-v{vol:g}" if vol != 1.0 else "") + ".wav"
    if os.path.exists(out):
        try:
            os.utime(out)
        except OSError:
            pass
    else:
        # asetrate*P shifts pitch AND tempo by P; one atempo of T/P lands the
        # final tempo on T. When T == P no atempo is needed (that's the
        # chipmunk chain), and atempo refuses factors under 0.5, so extreme
        # slowdowns are chained in 0.5 stages.
        af = []
        if a.pitch != 1.0:
            af.append(f"aresample=48000,asetrate=48000*{a.pitch},aresample=48000")
        net = a.tempo / a.pitch
        while net < 0.5:
            af.append("atempo=0.5")
            net *= 2
        if net != 1.0:
            af.append(f"atempo={net:g}")
        if vol != 1.0:
            af.append(f"volume={vol:g}")
        r = subprocess.run(["ffmpeg", "-loglevel", "error", "-y", "-i", raw,
                            "-af", ",".join(af), out])
        if r.returncode != 0:
            out = raw  # no ffmpeg or a bad filter: play it straight
# exec, not a subprocess: the plugin SIGTERMs this pid to cut a replaced
# line, and a child aplay would be orphaned and finish the old line over
# the new one (drag chatter stacked voices). After execvp the pid IS
# aplay, so the kill stops the audio.
os.execvp("aplay", ["aplay", "-q", out])
PY
  chmod +x "$base/speak-clone"

  CMD="exec $base/speak-clone --ref $base/voices/$NAME.wav --exag 0.5 --cfg 0.5"
  HELLO="Behold! It looks like you're giving me someone else's voice. How deliciously unethical."
  echo "the first line loads the model onto the GPU — give it a minute"
}

if [ "$MODE" = clone ]; then
  setup_clone
else
  # piper names carry a dash (en_US-ryan-high); kokoro ids don't (af_heart)
  case "$VOICE" in
    *-*) setup_piper ;;
    *) setup_kokoro ;;
  esac
fi

echo "${NAME:-$VOICE} says hello:"
echo "$HELLO" | bash -c "$CMD"

if command -v omarchy-shell >/dev/null && [ "$(omarchy-shell costafot.clippy state 2>/dev/null)" ]; then
  omarchy-shell costafot.clippy set tts "$CMD"
  echo "done — tts set. \`set tts true\` brings the robot back."
  if [ "$MODE" = clone ]; then
    # The plugin saw that set: it pre-renders the whole book for a clone
    # in the background (scripts/warm-voice), so the slap reaction and
    # the rest don't pay ~2 s of GPU the first time they're said.
    echo "he's pre-rendering the book for $NAME in the background (10-20 min of GPU, once); usable"
    echo "  meanwhile — a line not cached yet just takes ~2 s. \`voice\` says when it's done."
  fi
else
  echo "clippy isn't running; set it yourself:"
  echo "  omarchy-shell costafot.clippy set tts \"$CMD\""
fi
