#!/usr/bin/env python3
# Pre-render the whole quote book into the voice-clone cache, silently, so
# nothing Clippy says out of the book ever waits on the GPU. Only makes
# sense for a speak-clone `tts` command — it reads the live setting, so run
# it after setup-voice --clone, and rerun it after changing --ref/--exag/--cfg
# or re-cloning under the same name (the cache is keyed by all three plus the
# sample's contents; --pitch derives instantly and needs no warming). Templated lines ({away}, {back}, {kills}, {slaps}) are substituted at say-time and
# are skipped. ~2-3 s of GPU per line, 10-20 min for the built-in book.
# `--lines <line>...` warms exactly those strings instead of the book — the
# plugin uses it to pre-render each fresh batch of agent lines on arrival.
# The plugin also runs the bare form itself whenever the live voice becomes
# a clone (mount, useVoice, set tts), so a user never has to; by hand it's
# for a knob change. A full cache is a ~0.3 s no-op.
import hashlib, json, os, re, socket, subprocess, sys, time

def setting(key):
    r = subprocess.run(["omarchy-shell", "costafot.clippy", "get", key],
                       capture_output=True, text=True)
    v = r.stdout.strip() if r.returncode == 0 else ""
    # `get` prints string values JSON-quoted (booleans and numbers bare).
    if len(v) >= 2 and v[0] == '"' and v[-1] == '"':
        v = v[1:-1]
    return v

# `--tts <cmd>` hands in the command instead of reading the live setting —
# the plugin passes what it just applied, so a warm never races the write.
argv = sys.argv[1:]
if argv[:1] == ["--tts"] and len(argv) >= 2:
    tts, argv = argv[1], argv[2:]
else:
    tts = setting("tts")
m = re.search(r"(\S*speak-clone)\s+.*--ref\s+(\S+)", tts)
if not m:
    sys.exit(f"warm-voice: tts is not a speak-clone command, nothing to warm ({tts!r})")
ref = os.path.realpath(os.path.expanduser(m.group(2)))
if not os.path.isfile(ref):
    sys.exit(f"warm-voice: the reference sample is missing ({ref})")
# Must match speak-clone's key exactly. Since v1.28.0 it includes the ref's
# contents hash; a speak-clone written by an older setup-voice keys by path
# alone, and warming into keys it won't look up would be wasted GPU — so
# read the installed client and follow whichever scheme it uses.
with open(ref, "rb") as f:
    refhash = hashlib.sha256(f.read()).hexdigest()[:12]
try:
    legacy = "refhash" not in open(m.group(1)).read()
except OSError:
    legacy = False
if legacy:
    print("warm-voice: the installed speak-clone predates content-keyed caching — rerun scripts/setup-voice --clone to refresh it", file=sys.stderr)
def key_of(text):
    stem = f"{ref}|{exag}|{cfg}|{text}" if legacy else f"{ref}|{refhash}|{exag}|{cfg}|{text}"
    return hashlib.sha256(stem.encode()).hexdigest()[:24]
def flag(name, default):
    f = re.search(rf"--{name}\s+(\S+)", tts)
    return float(f.group(1)) if f else default
exag, cfg = flag("exag", 0.5), flag("cfg", 0.5)
daemon = os.path.join(os.path.dirname(os.path.realpath(m.group(1))), "daemon.py")

if argv[:1] == ["--lines"]:
    lines = [t for t in argv[1:] if "{" not in t]
else:
    here = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
    book = json.load(open(os.path.join(here, "quotes.json")))
    extra_path = setting("quotesFile")
    if extra_path and os.path.exists(os.path.expanduser(extra_path)):
        try:
            extra = json.load(open(os.path.expanduser(extra_path)))
            if isinstance(extra, list):
                extra = {"quotes": extra}
            for k, v in extra.items():
                if isinstance(v, dict):  # a reactions map: merge per pattern
                    b = book.setdefault(k, {})
                    for pat, lns in v.items():
                        b[pat] = b.get(pat, []) + lns
                else:
                    book.setdefault(k, []).extend(
                        {"text": e} if isinstance(e, str) else e for e in v)
        except (ValueError, OSError):
            pass  # the plugin ignores a broken quotesFile too
    clean = setting("clean") == "true"
    # reactions is a map of regex -> lines, not a list — flatten its values
    flat = [{"text": e} if isinstance(e, str) else e for v in book.values()
            for e in (sum(v.values(), []) if isinstance(v, dict) else v)]
    lines = [e["text"] for e in flat
             if "{" not in e["text"] and not (clean and e.get("nsfw"))]

cache = os.path.expanduser("~/.cache/clippy-voice")
os.makedirs(cache, exist_ok=True)
sockp = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "clippy-voice.sock")

def ask(text, out):
    c = socket.socket(socket.AF_UNIX)
    c.settimeout(120)
    c.connect(sockp)
    c.sendall((json.dumps({"text": text, "ref": ref, "exag": exag,
                           "cfg": cfg, "out": out}) + "\n").encode())
    r = c.makefile().readline().strip()
    c.close()
    if r != "ok":
        raise RuntimeError(r)

done = skipped = failed = 0
for text in lines:
    key = key_of(text)
    out = f"{cache}/{key}.wav"
    if os.path.exists(out):
        try:
            os.utime(out)  # counts as played: the daemon prunes least-recent first
        except OSError:
            pass  # pruned in the exists/utime gap — don't let it kill the warm
        skipped += 1
        continue
    for attempt in range(2):
        try:
            ask(text, out)
            done += 1
            break
        except (FileNotFoundError, ConnectionRefusedError):
            log = open(f"{cache}/daemon.log", "wb")
            subprocess.Popen([daemon], start_new_session=True, stdout=log, stderr=log)
            deadline = time.time() + 120
            while time.time() < deadline:
                time.sleep(0.5)
                try:
                    ask(text, out)
                    done += 1
                    break
                except (FileNotFoundError, ConnectionRefusedError):
                    continue
            else:
                sys.exit(f"warm-voice: daemon never came up "
                         f"({done} rendered, {skipped} cached, {failed} failed)")
            break
        except RuntimeError as e:
            if attempt:
                failed += 1
                print(f"FAIL: {e}: {text!r}", flush=True)
    n = done + skipped + failed
    if n % 20 == 0:
        print(f"{n}/{len(lines)}", flush=True)
print(f"done: {done} rendered, {skipped} already cached, {failed} failed of {len(lines)}")
