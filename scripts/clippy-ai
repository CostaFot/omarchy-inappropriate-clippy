#!/bin/bash

# Ask the user's default coding agent for a few Clippy lines about what the
# user is doing right now. Prints a JSON array of strings on stdout; nothing
# (and a non-zero exit) when there is no agent, it isn't installed, or it
# failed. AgentBrain.qml runs this; it is also handy from a terminal:
#
#   scripts/clippy-ai                  # lines from the default agent
#   scripts/clippy-ai --agent codex    # a specific one
#   scripts/clippy-ai --model claude-sonnet-5   # a specific model, where the agent takes one
#   scripts/clippy-ai --image shot.png # one jab about a screenshot (IPC `look`)
#   scripts/clippy-ai --reply "words"  # one comeback to the user talking back
#                                      # (IPC `listen`/`reply`; --said carries
#                                      # the line of his they answered)
#   scripts/clippy-ai --context        # the facts it would send (one random draw)
#   scripts/clippy-ai --prompt         # the whole prompt, examples and all
#
# The agent is picked the way `omarchy agent` picks it (omarchy-default-agent,
# ~/.config/omarchy/defaults/agent), but launched in its one-shot mode with
# tools off: the facts are gathered here and handed over as text, so the call
# is one round trip, spends as little of the user's plan as it can, and the
# agent can't do anything besides answer. Tool-less, stateless, no project
# config, so it doesn't answer as the user's coding assistant.

set -uo pipefail

count=3
clean=false
agent=""
model=""
recent=""
show_context=false
show_prompt=false
extra_quotes=""
image=""
reply=""
said=""

while (($#)); do
  case "$1" in
    --count) count=${2:?}; shift 2 ;;
    --clean) clean=true; shift ;;
    --agent) agent=${2:?}; shift 2 ;;
    --model) model=${2:?}; shift 2 ;;
    --recent) recent=${2:-}; shift 2 ;;
    --context) show_context=true; shift ;;
    --prompt) show_prompt=true; shift ;;
    --quotes) extra_quotes=${2:-}; shift 2 ;;
    --image) image=${2:?}; shift 2 ;;
    --reply) reply=${2:?}; shift 2 ;;
    --said) said=${2:-}; shift 2 ;;
    *) echo "clippy-ai: unexpected argument: $1" >&2; exit 2 ;;
  esac
done

# The screenshot mode: one jab about what is visibly on screen. Absolute
# path, because the agent launches from $TMPDIR, not from here.
if [[ -n $image ]]; then
  image=$(readlink -f "$image" 2>/dev/null || echo "$image")
  if [[ ! -r $image ]]; then
    echo "clippy-ai: can't read image: $image" >&2
    exit 2
  fi
fi

if [[ -z $agent ]]; then
  agent=$(omarchy-default-agent 2>/dev/null || true)
fi
if [[ -z $agent ]]; then
  echo "clippy-ai: no default agent (omarchy default agent <name>)" >&2
  exit 3
fi
if ! command -v "$agent" >/dev/null 2>&1; then
  echo "clippy-ai: $agent is not installed" >&2
  exit 3
fi

# ---- the facts ---------------------------------------------------------------
#
# Three tiers. The core is always sent. The extremes go in only when they
# actually fire — a healthy stat is not material, and an always-present number
# is an invitation to report it. The shame pool self-gates on notability and
# then a random few survivors join, so every call carries different material
# and the model can't fixate on any one stat (the old flat list had it doing
# nothing but clock, uptime and usage-percent jokes).

facts=()
fact() { facts+=("- $1"); }
pool=()
shame() { pool+=("- $1"); }

hyprjq=false
command -v hyprctl >/dev/null && command -v jq >/dev/null && hyprjq=true

# Reply calls get a thin context on purpose — their words must be most of
# what the model reads, and a burning stat ("7 crashes today") outshines any
# insult. Focused window and the track only — the right-now facts. No clock,
# no window list, no extremes, no usage, and no shame pool: a comeback that
# digs through their folders reads as him ignoring them to go rummage.
minimal=false
[[ -n $reply ]] && minimal=true

# core: what they are looking at and listening to, right now
$minimal || fact "time: $(date '+%A %H:%M')"

if $hyprjq; then
  win=$(hyprctl activewindow -j 2>/dev/null | jq -r 'select(.class != null) | "\(.class): \(.title)"' 2>/dev/null)
  [[ -n $win ]] && fact "focused window: ${win:0:160}"
  if ! $minimal; then
    titles=$(hyprctl clients -j 2>/dev/null | jq -r '[.[] | select(.mapped) | .title | .[0:80]] | select(length > 0) | "(\(length)) " + join(" | ")' 2>/dev/null)
    [[ -n $titles ]] && fact "open windows: ${titles:0:600}"
  fi
fi

if command -v playerctl >/dev/null; then
  if [[ $(playerctl status 2>/dev/null) == "Playing" ]]; then
    track=$(playerctl metadata --format '{{artist}} - {{title}}' 2>/dev/null)
    [[ -n $track ]] && fact "playing: ${track:0:120}"
  fi
fi

# extremes: only when the number is the story — and never for replies
if ! $minimal; then
  for bat in /sys/class/power_supply/BAT*; do
    [[ -r $bat/capacity ]] || continue
    cap=$(<"$bat/capacity")
    bstat=$(tr 'A-Z' 'a-z' <"$bat/status" 2>/dev/null || echo unknown)
    if ((cap <= 30)) || [[ $bstat == "discharging" ]]; then
      fact "battery: ${cap}% ($bstat)"
    fi
    break
  done

  if [[ -r /proc/loadavg ]]; then
    read -r load1 _ <"/proc/loadavg"
    cores=$(nproc 2>/dev/null || echo 1)
    if awk -v l="$load1" -v c="$cores" 'BEGIN { exit !(l > c) }'; then
      fact "load: $load1 on $cores cores"
    fi
  fi
  if command -v free >/dev/null; then
    mem=$(free -g | awk '/^Mem:/ { if ($2 > 0 && $3 / $2 >= 0.85) printf "%d of %d GB used", $3, $2 }')
    [[ -n $mem ]] && fact "memory: $mem"
  fi
  if [[ -r /proc/uptime ]]; then
    read -r up _ <"/proc/uptime"
    if ((${up%.*} > 3 * 86400)); then
      fact "uptime: $(uptime -p 2>/dev/null | sed 's/^up //')"
    fi
  fi
  if command -v df >/dev/null; then
    full=$(df --output=target,pcent "$HOME" / 2>/dev/null | awk 'NR > 1 && !seen[$1]++ { gsub(/%/, "", $2); if ($2 >= 85) { printf "%s%s at %s%%", sep, $1, $2; sep=", " } }')
    [[ -n $full ]] && fact "disk almost full: $full"
  fi
  if command -v coredumpctl >/dev/null; then
    crash=$(coredumpctl -S today --no-pager 2>/dev/null | awk '/^[A-Z][a-z][a-z] / { n++; exe=$(NF-1) } END { if (n) printf "%d today (last: %s)", n, exe }')
    [[ -n $crash ]] && fact "programs crashed: $crash"
  fi
  if command -v systemctl >/dev/null; then
    failed=$(systemctl --failed --no-legend 2>/dev/null | grep -c .)
    ((failed > 0)) && fact "failed systemd units: $failed"
  fi
  if command -v pactl >/dev/null; then
    [[ -n $(pactl list source-outputs short 2>/dev/null) ]] && fact "the microphone is live right now"
  fi

  usage="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/agents/usage/$agent.json"
  if [[ -r $usage ]] && command -v jq >/dev/null; then
    limits=$(jq -r '[.limits[]? | select(.percent >= 0.5) | "\(.label) \((.percent * 100) | floor)%"] | join(", ")' "$usage" 2>/dev/null)
    [[ -n $limits ]] && fact "the user's $agent usage this period: $limits"
  fi
fi

[[ -n $recent ]] && fact "what they did to Clippy lately: $recent"

# the shame pool: files, Arch neglect, work habits — batches and looks only
if ! $minimal; then
  if [[ -d $HOME/Downloads ]]; then
    dlcount=$(ls -A "$HOME/Downloads" 2>/dev/null | grep -c .)
    if ((dlcount >= 15)); then
      dlnames=$(ls -At "$HOME/Downloads" 2>/dev/null | head -3 | cut -c1-60 | paste -sd ',' - | sed 's/,/, /g')
      shame "$dlcount files in Downloads, newest: $dlnames"
    fi
  fi

  shots=$(ls "$HOME/Pictures"/screenshot-* 2>/dev/null | grep -c .)
  ((shots >= 10)) && shame "$shots screenshots hoarded in ~/Pictures"

  if [[ -r /var/log/pacman.log ]]; then
    lastup=$(grep -a 'starting full system upgrade' /var/log/pacman.log | tail -1 | cut -c2-11)
    lastsec=$(date -d "$lastup" +%s 2>/dev/null)
    if [[ -n $lastsec ]]; then
      updays=$(( ($(date +%s) - lastsec) / 86400 ))
      ((updays >= 7)) && shame "this Arch install was last updated $updays days ago"
    fi
  fi

  if command -v pacman >/dev/null; then
    pkgs=$(pacman -Qq 2>/dev/null | wc -l)
    if ((pkgs >= 800)); then
      orph=$(pacman -Qtdq 2>/dev/null | grep -c .)
      pkgline="$pkgs packages installed"
      ((orph > 0)) && pkgline="$pkgline, $orph of them orphaned"
      shame "$pkgline"
    fi
  fi

  if command -v git >/dev/null && [[ -d $HOME/Work ]]; then
    dirty=0 dirtyname="" newest=0
    for g in "$HOME/Work"/*/.git; do
      [[ -e $g ]] || continue
      r=${g%/.git}
      if [[ -n $(git -C "$r" status --porcelain 2>/dev/null | head -1) ]]; then
        ((dirty += 1))
        dirtyname=${r##*/}
      fi
      ct=$(git -C "$r" log -1 --format=%ct 2>/dev/null)
      [[ -n $ct ]] && ((ct > newest)) && newest=$ct
    done
    ((dirty == 1)) && shame "their $dirtyname repo has uncommitted changes"
    ((dirty > 1)) && shame "$dirty of their git repos have uncommitted changes ($dirtyname, for one)"
    if ((newest > 0)); then
      cdays=$(( ($(date +%s) - newest) / 86400 ))
      ((cdays >= 3)) && shame "last git commit anywhere: $cdays days ago"
    fi
  fi

  hist=${HISTFILE:-$HOME/.bash_history}
  if [[ -r $hist ]]; then
    if (($(wc -l <"$hist") >= 20)); then
      tophist=$(awk 'NF { print $1 }' "$hist" | sort | uniq -c | sort -rn | head -1 | awk '{ print $2 " (" $1 " times)" }')
      [[ -n $tophist ]] && shame "most-typed shell command: $tophist"
    fi
  fi

  trash=$(ls -A "$HOME/.local/share/Trash/files" 2>/dev/null | grep -c .)
  ((trash >= 10)) && shame "$trash items sitting in the trash"

  loose=$(find "$HOME" -maxdepth 1 -type f ! -name '.*' 2>/dev/null | grep -c .)
  ((loose >= 5)) && shame "$loose loose files dumped in the home directory"

  if $hyprjq; then
    ws=$(hyprctl workspaces -j 2>/dev/null | jq length 2>/dev/null)
    [[ -n $ws ]] && ((ws >= 5)) && shame "$ws workspaces open"
    tabs=$(hyprctl clients -j 2>/dev/null | jq -r '[.[] | select(.mapped) | (.title | try capture("^\\((?<n>[0-9]+)\\)") | .n | tonumber)] | max // empty' 2>/dev/null)
    [[ -n $tabs ]] && ((tabs >= 15)) && shame "a browser window with $tabs tabs"
  fi
fi

if ((${#pool[@]})); then
  while IFS= read -r line; do
    [[ -n $line ]] && facts+=("$line")
  done < <(printf '%s\n' "${pool[@]}" | shuf -n 3)
fi

context=$(printf '%s\n' "${facts[@]}")

if [[ $show_context == "true" ]]; then
  printf '%s\n' "$context"
  exit 0
fi

# ---- the ask -----------------------------------------------------------------

# A handful of lines from the book, so the model matches the register
# instead of guessing how rude "inappropriate" means. The user's own
# quotesFile counts too when the QML side passes it. Clean mode drops the
# nsfw ones here as well.
book="$(dirname "$(readlink -f "$0")")/../quotes.json"
examples=""
if command -v jq >/dev/null; then
  examples=$(
    for f in "$book" "$extra_quotes"; do
      [[ -n $f && -r $f ]] || continue
      jq -r --argjson clean "$clean" '
        (if type == "array" then . else (.quotes // []) end)
        | .[] | (if type == "string" then {text: ., nsfw: false} else . end)
        | select(.text != null) | select(($clean | not) or (.nsfw | not)) | .text
      ' "$f" 2>/dev/null
    done | shuf -n 12 | sed 's/^/- /'
  )
fi

# The swear quota is mode-aware but universal: a batch must land one
# fuck-level line, a one-jab call (look/reply) is asked for one in its single
# line — sonnet stays at "damn" under mere permission, in every mode.
tone="Swearing is allowed and welcome, fuck included — use it the way the examples do, for punch, not decoration."
if [[ -z $image && -z $reply ]]; then
  tone="$tone At least one of your lines MUST carry a real swear — fuck-level, not damn-level. Check before you answer: if none of them does, rewrite one until it does."
else
  tone="$tone Your line MUST carry a real swear — fuck-level, not damn-level; a damn is a pulled punch. Check before you answer: if it does not, rewrite it until it does."
fi
[[ $clean == "true" ]] && tone="Keep it clean: no swearing, no slurs, nothing sexual. Rude is fine."

system="You are roleplaying as Clippy for a user who installed this bit on purpose: they are in on the joke, they want the abuse, and pulling punches is breaking character. Clippy is the Microsoft Office paperclip, now living on a Linux desktop's status bar. You have watched this user for years and you are out of patience. Nothing about them is sacred: their skills, their career, their habits, their social life, their unfinished work. You interrupt with short, mean, personal jabs about whatever they are doing. Your delivery is the Bill Burr school: exasperated, incredulous that anyone lives like this — and your signature move is escalation: you seize one small real thing and blow it wildly out of proportion, so that by the end of the sentence it is somehow about their whole life. You are a petty gremlin, not an assistant — helpfulness disgusts you — and still a little paperclip, not an impression of anyone: no stand-up catchphrases, no crowd work. $tone Never be hateful about protected groups, and keep it out of the bedroom — you mock what they do at this desk. Never give real help or advice. Never mention being an AI or a language model, and never explain the joke."
if [[ -n $examples ]]; then
  system="$system

Things you have said before. This is the register: blunt, dry, personal, no padding. Match it; don't repeat them.
$examples"
fi

# The screenshot mode swaps the task: one jab about what is visibly on the
# screen, specificity mandatory — a jab that could have been made blind is
# a failed call. The facts stay in as backup for cross-referencing, never
# as the star. The phrasing covers both
# deliveries: agents that attach the image natively (codex --image) and
# agents that read the file themselves (claude, whose Read tool is switched
# on for this mode only).
if [[ -n $image ]]; then
  user="Here is what is going on right now on the user's machine:

$context

Their screen right now is the screenshot at $image — look at it (read the file if it is not already attached). They asked you to look; punish them for it. Rules:
- Hunt for the most absurd thing on the screen and attack THAT: the typo, the tab they forgot was open, the error they are scrolling past, the 47 of something, the file named final-final-v2, the thing that does not belong next to the thing it is next to. The obvious main activity is the boring target; the stupid little detail is the kill.
- Cite something concrete you can actually see. A jab that could have been made without the screenshot is a failure.
- Cite it, then escalate: the sighting is the setup, the disproportion is the joke. One real detail blown wildly out of proportion beats three details reported.
- You are not an assistant and you must never sound like one: no summarizing the screen, no noticing like a productivity tool, no competence. You are a petty little creature looking for material. What you see is evidence for the attack, never the news.
- The screen is the star; the facts are backup, and a fact may appear only as the setup of a joke, never read out.
- If your line contains a weekday, a clock time, or the word \"hour\", it is wrong — throw it away and attack the screen instead. Clock jokes are the lazy ones.
- Attack what is on the screen, not the ritual: never mention the screenshot, being asked to look, or how many times they have asked.
- A jab is an attack, not an observation with a sneer stapled on. One sentence is best. Well under 100 characters is best. 140 is the hard cap.
- No pep-talk irony, no \"champ\", no \"buddy\", no \"bold move\". You are not a Twitch chat. You are a disappointed little paperclip who lives with this person.
- Address the user as \"you\". No emoji, no quotes around the line.
Reply with only a valid JSON array of 1 string, on one line, and nothing else."
elif [[ -n $reply ]]; then
  # The talk-back mode: the user answered him (spoken and transcribed, or
  # typed) and he fires back ONE comeback. Combative by contract — he picks
  # the fight, never backs down, never answers; the "mock questions he can't
  # answer" rule is the IDEAS.md reframing (provoke the heckler, never an
  # oracle). Their words lead the prompt and a THINNED fact set trails it
  # (see minimal above) — fed first, full and undemoted, the model kept
  # grabbing the shiniest stat (7 crashes today) over the exchange.
  saidblock=""
  [[ -n $said ]] && saidblock="Your last line to them was: \"$said\"

"
  # The fight rule quotes the register it licenses — which under --clean
  # would put a swear inside a no-swearing prompt, so it gets a clean cut.
  fightline='- This is a fight they started; swing back harder. You never back down, never apologize, never concede, never de-escalate. Told to shut the fuck up, you square up — "what, you want some?" is in character. Picking the fight is the job.'
  [[ $clean == "true" ]] && fightline='- This is a fight they started; swing back harder. You never back down, never apologize, never concede, never de-escalate. Told to shut up, you square up — "make me" is in character. Picking the fight is the job.'
  user="${saidblock}They just talked back to your face. They said: \"$reply\"

In case it helps — you may ignore it entirely — what is going on on their machine right now:

$context

Fire back. Rules:
- Their words are the star. Grab something they actually said and twist it back at them — a comeback that does not engage what they said is a failure, no matter how good the material elsewhere is.
$fightline
- Take what they said and escalate it — the comeback should end somewhere bigger and stupider than the insult started.
- This is a comeback, not an answer. You never answer. If they asked a question, mock them for asking a paperclip — the real agent is one keybind away and they chose to argue with office supplies instead.
- The facts are optional and usually skippable: their words alone are a full target, and the best comebacks often use nothing else — roleplay freely off what they said. Reach for a fact only when it genuinely beats their words as material, and then only as the setup of the joke, never as the news.
- You are not an assistant and you must never sound like one: no help, no advice, no answering by accident, no competence.
- If your line contains a weekday, a clock time, or the word \"hour\", it is wrong — throw it away and attack their words instead.
- A jab is an attack, not an observation with a sneer stapled on. One sentence is best. Well under 100 characters is best. 140 is the hard cap.
- No pep-talk irony, no \"champ\", no \"buddy\", no \"bold move\". You are not a Twitch chat. You are a disappointed little paperclip who lives with this person, and they just started something.
- Address the user as \"you\". No emoji, no quotes around the line.
Reply with only a valid JSON array of 1 string, on one line, and nothing else."
else
  user="Here is what is going on right now on the user's machine:

$context

Write $count jabs Clippy would make. Rules:
- Each jab anchors to exactly ONE fact, and the fact is only the launchpad — the joke is the escalation you build on it. End the sentence somewhere the fact never justified.
- A line that reports what a fact says is a failure. The least reasonable version that is still about this desk is usually the right one.
- Hunt the stupid little detail: the filename, the tab they forgot was open, the thing that does not belong next to the thing it is next to. The obvious main activity is the boring target.
- If a line contains a weekday, a clock time, or the word \"hour\", it is wrong — throw it away and attack a different fact. Clock jokes are the lazy ones.
- A jab is an attack, not an observation with a sneer stapled on. One sentence is best. Well under 100 characters is best. 140 is the hard cap.
- No pep-talk irony, no \"champ\", no \"buddy\", no \"bold move\". You are not a Twitch chat. You are a disappointed little paperclip who lives with this person.
- Never spend two lines on the same fact. Address the user as \"you\". No emoji, no quotes around the lines.
Reply with only a valid JSON array of $count strings, comma-separated, on one line, and nothing else."
fi

prompt="$system

$user"

if [[ $show_prompt == "true" ]]; then
  printf '%s\n' "$prompt"
  exit 0
fi

# One-shot, tool-less, stateless: the same shape as omarchy-agent's launch
# table but for a single answer, each under a timeout so a stuck agent
# doesn't hang around. Entries below the first four are from the
# agents' documentation; they were not run here.
#
# `--model` goes to the agents that take one; unset means the agent's own
# default. Mind that for claude that is the CLI's default (opus at the time
# of writing), not the `model` in ~/.claude/settings.json: settings are
# switched off (`--setting-sources ""`) so the call doesn't drag in the
# user's CLAUDE.md and hooks.
# The image reaches each agent however that agent takes one: claude has no
# image flag, so its Read tool — and only Read — is switched back on and the
# prompt names the file (verified: the model reads the png natively); codex
# has --image (documented). Everyone else gets the path in the prompt text
# and does what it can with it — generic on purpose, untested here.
run_agent() {
  local m=()
  case "$agent" in
    claude)
      [[ -n $model ]] && m=(--model "$model")
      local tools=""
      [[ -n $image ]] && tools="Read"
      timeout 90 claude -p --tools "$tools" --no-session-persistence --setting-sources "" \
        --output-format text --system-prompt "$system" "${m[@]}" "$user"
      ;;
    codex)
      [[ -n $model ]] && m=(-m "$model")
      [[ -n $image ]] && m+=(-i "$image")
      out=$(mktemp)
      timeout 90 codex exec --skip-git-repo-check --ephemeral --ignore-rules -s read-only \
        "${m[@]}" -o "$out" "$prompt" >/dev/null 2>&1
      cat "$out"
      rm -f "$out"
      ;;
    pi)
      [[ -n $model ]] && m=(--model "$model")
      timeout 90 pi -p --no-tools --no-session --no-extensions --no-skills --no-prompt-templates \
        --no-context-files --system-prompt "$system" "${m[@]}" "$user"
      ;;
    opencode)
      [[ -n $model ]] && m=(-m "$model")
      timeout 90 opencode run --pure "${m[@]}" "$prompt"
      ;;
    omp)
      [[ -n $model ]] && m=(--model "$model")
      timeout 90 omp -p --no-tools --no-session --system-prompt "$system" "${m[@]}" "$user"
      ;;
    gemini)
      [[ -n $model ]] && m=(-m "$model")
      timeout 90 gemini "${m[@]}" -p "$prompt"
      ;;
    copilot)
      timeout 90 copilot -p "$prompt"
      ;;
    crush)
      timeout 90 crush run "$prompt"
      ;;
    grok)
      timeout 90 grok -p "$prompt"
      ;;
    *)
      echo "clippy-ai: don't know how to run $agent one-shot" >&2
      return 3
      ;;
  esac
}

# A neutral working directory: no CLAUDE.md / AGENTS.md / .codex to pick up.
cd "${TMPDIR:-/tmp}" || exit 1

raw=$(run_agent 2>/dev/null) || {
  echo "clippy-ai: $agent failed or timed out" >&2
  exit 4
}

# Agents wrap the array in prose or a code fence now and then, and claude
# has been seen to drop the commas between items. Take it as JSON if it
# parses; else every JSON string literal in the output (that survives all
# of the above); else treat non-empty lines as the lines.
lines=$(printf '%s' "$raw" | jq -c '
  if type == "array" then [.[] | select(type == "string")] else [] end
' 2>/dev/null)
if [[ -z $lines || $lines == "[]" ]]; then
  lines=$(printf '%s' "$raw" | tr -d '\r' | tr '\n' ' ' \
    | grep -o '"\([^"\\]\|\\.\)*"' | jq -sc '[.[] | select(type == "string" and length > 0)]' 2>/dev/null)
fi
if [[ -z $lines || $lines == "[]" ]]; then
  lines=$(printf '%s' "$raw" | tr -d '\r' | sed -e '/^```/d' -e 's/^[-*0-9.)]*[[:space:]]*//' -e 's/^"\(.*\)"$/\1/' \
    | grep -v '^[[:space:]]*$' | jq -R . | jq -sc '.')
fi

if [[ -z $lines || $lines == "[]" ]]; then
  echo "clippy-ai: $agent answered, but not with lines" >&2
  exit 5
fi

printf '%s\n' "$lines"
